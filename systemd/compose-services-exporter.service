[Unit]
Description=Homelab compose services exporter (every default service has a running container)
Documentation=file:///home/luk-server/homelab/scripts/monitoring/compose-services-exporter.sh
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/home/luk-server/homelab/scripts/monitoring/compose-services-exporter.sh
Environment="TEXTFILE_DIR=/var/lib/node_exporter/textfile"
Environment="REPO_DIR=/home/luk-server/homelab"
StandardOutput=journal
StandardError=journal
