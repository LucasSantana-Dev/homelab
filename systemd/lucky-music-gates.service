[Unit]
Description=Lucky: weekly music-first gates report
Documentation=file:///home/luk-server/homelab/scripts/agent-tasks/lucky-music-gates.sh
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=luk-server
# Runs from the checkout (kept current by git pull), not a copy under /opt
# that can go stale.
ExecStart=/home/luk-server/homelab/scripts/agent-tasks/lucky-music-gates.sh
# A hung docker exec or query must not block the next weekly run.
TimeoutStartSec=10min
StandardOutput=journal
StandardError=journal
