[Unit]
Description=Homelab Docker storage reclamation
Documentation=file:///opt/homelab/scripts/maintenance/docker-prune.sh
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/opt/homelab/scripts/maintenance/docker-prune.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
