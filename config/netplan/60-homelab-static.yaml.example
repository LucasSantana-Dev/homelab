network:
  version: 2
  ethernets:
    enp1s0:
      dhcp4: false
      addresses:
        - 192.168.0.11/24
      routes:
        - to: default
          via: 192.168.0.1
      nameservers:
        addresses:
          - 127.0.0.1
          - 1.1.1.1
          - 8.8.8.8
        search:
          - home
