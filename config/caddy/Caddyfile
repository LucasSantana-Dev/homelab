{
	auto_https off
	default_bind 0.0.0.0
}

# Forward-auth via Tinyauth — applied to all public services that need OAuth.
# caddy-lan runs on host network; tinyauth binds 127.0.0.1:3030.
(protected) {
	forward_auth 127.0.0.1:3030 {
		uri /api/auth/caddy
		copy_headers Remote-User Remote-Email Remote-Name
		header_up X-Forwarded-Proto https
	}
}

# ---------- LAN (*.home) ----------

http://ai.home {
	reverse_proxy 127.0.0.1:3000
}

http://craftvaria.home {
	reverse_proxy 127.0.0.1:3333
}

http://lucky.home {
	reverse_proxy 127.0.0.1:8090
}

http://registry.home {
	reverse_proxy 127.0.0.1:5000
}

http://pihole.home {
	redir / /admin/
	reverse_proxy 127.0.0.1:8054
}

http://cockpit.home {
	reverse_proxy https://127.0.0.1:9090 {
		transport http {
			tls_insecure_skip_verify
		}
	}
}

http://stremio.home {
	reverse_proxy 127.0.0.1:11470
}


http://n8n.home {
	reverse_proxy 127.0.0.1:5678
}

http://linkding.home {
	reverse_proxy 127.0.0.1:9095
}

http://miniflux.home {
	reverse_proxy 127.0.0.1:9094
}

http://forgejo.home {
	reverse_proxy 127.0.0.1:9096
}

http://homelab.home, http://home {
	respond "homelab services: ai.home craftvaria.home lucky.home registry.home pihole.home cockpit.home stremio.home n8n.home linkding.home miniflux.home forgejo.home" 200
}

# ---------- Public HTTPS via Cloudflare Tunnel (*.luk-homeserver.com.br) ----------
#
# Cloudflare terminates TLS at the edge; cloudflared forwards plain HTTP
# to this caddy instance, which routes each hostname to the correct
# backend. k3s apps get their traffic via the Traefik ClusterIP with
# a Host rewrite; docker-native services get direct 127.0.0.1 proxying.

http://luk-homeserver.com.br, http://www.luk-homeserver.com.br, http://home.luk-homeserver.com.br {
	reverse_proxy 127.0.0.1:3010
}

# Docker-native services on host ports (no k3s dependency)
http://homeassistant.luk-homeserver.com.br {
	reverse_proxy 127.0.0.1:8123
}

http://cloud.luk-homeserver.com.br {
	reverse_proxy 127.0.0.1:8300 {
		transport http {
			read_timeout 600s
		}
	}
}

http://stremio.luk-homeserver.com.br {
	import protected
	reverse_proxy 127.0.0.1:11470
}
http://miniflux.luk-homeserver.com.br {
	import protected
	reverse_proxy 127.0.0.1:9094
}

http://forgejo.luk-homeserver.com.br {
	import protected
	reverse_proxy 127.0.0.1:9096
}

http://linkding.luk-homeserver.com.br {
	import protected
	reverse_proxy 127.0.0.1:9095
}

http://n8n.luk-homeserver.com.br {
	import protected
	reverse_proxy 127.0.0.1:5678
}


http://grafana.luk-homeserver.com.br {
