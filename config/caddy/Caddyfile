{
	auto_https off
	default_bind 0.0.0.0
}

# Forward-auth via Tinyauth — applied to all public services that need OAuth.
# caddy-lan runs on host network; tinyauth binds 127.0.0.1:3030.
(protected) {
	forward_auth 127.0.0.1:3030 {
		uri /api/auth/caddy
		copy_headers Remote-User Remote-Email Remote-Name
		header_up X-Forwarded-Proto https
	}
}

# ---------- LAN (*.home) ----------

http://ai.home {
	reverse_proxy 127.0.0.1:3000
}

http://craftvaria.home {
	reverse_proxy 127.0.0.1:3333
}

http://lucky.luk-homeserver.com.br {
	import protected
	reverse_proxy 127.0.0.1:8090
}

http://lucky.home {
	reverse_proxy 127.0.0.1:8090
}

# CoJam public app on cojam.lucassantana.tech (single subdomain, path-routed).
# /connection/* (centrifuge WebSocket) and /api/* (connection-token + apple
# dev-token) go to the Go server on :8094; everything else (Next app, /env.js,
# /callback, /room) goes to the web frontend on :8092. The web app defines no
# /api/* routes, so this split is collision-free. No `import protected`: browser
# WebSocket clients cannot pass the Tinyauth forward-auth and the room app is
# meant to be openly reachable.
http://cojam.lucassantana.tech {
	@backend path /connection/* /api/*
	handle @backend {
		reverse_proxy 127.0.0.1:8094
	}
	handle {
		reverse_proxy 127.0.0.1:8092
	}
}

# LAN access (*.home) keeps the two-subdomain split for local testing.
http://cojam-api.home {
	reverse_proxy 127.0.0.1:8094
}

http://cojam.home {
	reverse_proxy 127.0.0.1:8092
}

http://registry.home {
	reverse_proxy 127.0.0.1:5000
}

http://pihole.home {
	redir / /admin/
	reverse_proxy 127.0.0.1:8054
}

http://cockpit.home {
	reverse_proxy https://127.0.0.1:9090 {
		transport http {
			# tls_insecure_skip_verify is intentional (#215): cockpit serves a
			# self-signed cert that regenerates, and this hop is loopback with no
			# MITM surface. Pinning would break on cert rotation for no real gain.
			tls_insecure_skip_verify
		}
	}
}

