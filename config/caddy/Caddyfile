}

# ---------- Public HTTPS via Cloudflare Tunnel (*.luk-homeserver.com.br) ----------
#
# Cloudflare terminates TLS at the edge; cloudflared forwards plain HTTP
# to this caddy instance, which routes each hostname to the correct
# backend. k3s apps get their traffic via the Traefik ClusterIP with
# a Host rewrite; docker-native services get direct 127.0.0.1 proxying.

http://luk-homeserver.com.br, http://www.luk-homeserver.com.br, http://home.luk-homeserver.com.br {
	reverse_proxy 127.0.0.1:3010
}

# Docker-native services on host ports (no k3s dependency)
# No `import protected` by design: Home Assistant has its own login (+ optional MFA),
# and its mobile app / REST API authenticate with long-lived tokens that a tinyauth
# forward-auth gate would block. Public exposure relies on HA's own auth — intentional
# (audit-deep 2026-06-19 reconciliation; do not "fix" without breaking the HA app).
http://homeassistant.luk-homeserver.com.br {
	reverse_proxy 127.0.0.1:8123
}

# No `import protected` by design: Nextcloud has its own login; desktop/mobile sync
# clients use app passwords that a tinyauth forward-auth gate would block. Intentional.
http://cloud.luk-homeserver.com.br {
	reverse_proxy 127.0.0.1:8300 {
		transport http {
			read_timeout 600s
		}
	}
}

http://stremio.luk-homeserver.com.br {
	import protected
	reverse_proxy 127.0.0.1:11470
}
http://miniflux.luk-homeserver.com.br {
	import protected
	reverse_proxy 127.0.0.1:9094
}

http://forgejo.luk-homeserver.com.br {
	# Bypass tinyauth for OAuth2 server-to-server endpoints
	@oauth2_paths path /login/oauth/access_token /login/oauth/keys /login/oauth/userinfo /.well-known/openid-configuration
	reverse_proxy @oauth2_paths 127.0.0.1:9096

	@needs_auth not path /login/oauth/access_token /login/oauth/keys /login/oauth/userinfo /.well-known/openid-configuration
	forward_auth @needs_auth 127.0.0.1:3030 {
		uri /api/auth/caddy
		copy_headers Remote-User Remote-Email Remote-Name
		header_up X-Forwarded-Proto https
	}
	reverse_proxy 127.0.0.1:9096
}

