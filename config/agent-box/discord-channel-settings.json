{
  "promptSuggestionEnabled": false,
  "enabledPlugins": {
    "discord@claude-plugins-official": true
  },
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "mcp__plugin_discord_discord",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "TodoWrite",
      "Bash"
    ],
    "deny": [
      "Read(~/.claude/channels/**)",
      "Edit(~/.claude/channels/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.claude.json)",
      "Read(~/.config/gh/**)",
      "Read(/run/secrets/**)",
      "Read(/etc/profile.d/agent-env.sh)",
      "Edit(~/.claude/settings.json)",
      "Edit(/opt/agent-config/**)",
      "Bash(env*)",
      "Bash(printenv*)",
      "Bash(cat ~/.claude*)",
      "Bash(cat /home/agent/.claude*)",
      "Bash(cat ~/.config/gh*)",
      "Bash(cat /run/secrets*)",
      "Bash(gh auth token*)",
      "Bash(gh pr merge*)",
      "Bash(gh pr close*)",
      "Bash(gh pr review*)",
      "Bash(gh api*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push*--force*)",
      "Bash(git push*--delete*)",
      "Bash(git push*+*)",
      "Bash(git push*:**)",
      "Bash(git push origin main*)",
      "Bash(git push origin master*)",
      "Bash(git push origin release*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git push origin HEAD:release*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(rm -rf*)",
      "Bash(sudo*)",
      "Bash(curl*)",
      "Bash(wget*)",
      "Bash(gh secret*)",
      "Bash(gh repo delete*)",
      "Bash(gh label delete*)",
      "WebFetch",
      "WebSearch"
    ]
  }
}
