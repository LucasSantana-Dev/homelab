# agent-box secrets — these go into secrets/agent-box.secrets.yaml.age (SOPS-encrypted)
# Encrypt with: sops --encrypt --age <AGE_PUBKEY> --input-type yaml --output-type yaml plain.yaml > encrypted.age

# Claude MAX OAuth authentication (NOT an API key — claude CLI uses OAuth)
# Run: ssh -t -L 1455:localhost:1455 agent-box "claude" to trigger OAuth flow
ANTHROPIC_API_KEY=PENDING_OAUTH_NOT_API_KEY

# GitHub fine-grained PAT for LucasSantana-Dev (NOT vsantana-org — org blocks fine-grained PATs)
# Scopes needed: contents:write, pull_requests:write, issues:write, actions:read, metadata:read
# Expiry: max 366 days (GitHub limit); rotate before expiry
AGENT_GITHUB_TOKEN=github_pat_REPLACE_ME

# Discord webhook for agent-box notifications
# Create in Discord: Server Settings → Integrations → Webhooks
AGENT_DISCORD_WEBHOOK=https://discord.com/api/webhooks/REPLACE_ME

# age encryption key path on homelab (for SOPS decryption in task scripts)
# Default: /home/luk-server/.config/sops/age/keys.txt
# Public key: age18qmemsqgr3gpcmmhjwjmhpp8tqd2ae5s0g5x0u4qwuu94nx3fuls8t5fc8
# SOPS_AGE_KEY_FILE=/home/luk-server/.config/sops/age/keys.txt

# --- Container rebuild ---
# After changing secrets: docker restart agent-box
# Full rebuild (Dockerfile change): docker compose -f compose/agent-box.yml build && docker compose -f compose/agent-box.yml up -d
# Codex OAuth re-auth (after --force-recreate): ssh -t -L 1455:localhost:1455 agent-box "codex login"
