FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8

# Base packages + locales + SSH
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl wget git openssh-server sudo jq \
    ca-certificates gnupg lsb-release \
    locales age python3 python3-pip rsync && \
    locale-gen en_US.UTF-8 && \
    update-locale LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 && \
    rm -rf /var/lib/apt/lists/*

# Node.js 22
# hadolint ignore=DL4006
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    rm -rf /var/lib/apt/lists/*

# GitHub CLI
# hadolint ignore=DL4006
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
    | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] \
    https://cli.github.com/packages stable main" \
    | tee /etc/apt/sources.list.d/github-cli.list && \
    apt-get update && apt-get install -y --no-install-recommends gh && \
    rm -rf /var/lib/apt/lists/*

# Docker CLI only (no daemon)
# hadolint ignore=DL4006
RUN curl -fsSL https://download.docker.com/linux/ubuntu/gpg \
    | gpg --dearmor -o /usr/share/keyrings/docker-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/docker-archive-keyring.gpg] \
    https://download.docker.com/linux/ubuntu $(lsb_release -cs) stable" \
    | tee /etc/apt/sources.list.d/docker.list && \
    apt-get update && apt-get install -y --no-install-recommends docker-ce-cli && \
    rm -rf /var/lib/apt/lists/*

# SOPS
RUN curl -fsSL https://github.com/getsops/sops/releases/download/v3.9.4/sops-v3.9.4.linux.amd64 \
    -o /usr/local/bin/sops && chmod +x /usr/local/bin/sops

# uv (for uvx / mcp-server-fetch and other MCP tools)
# hadolint ignore=DL3013
RUN pip3 install --no-cache-dir uv --break-system-packages && \
    ln -sf /usr/local/bin/uv /usr/local/bin/uvx 2>/dev/null || true

# Claude CLI + OpenCode
# hadolint ignore=DL3016
# PINNED: @openai/codex@0.125.0 — newer versions (>=0.126) reject gpt-5.4 with ChatGPT Pro OAuth.
# Upgrade only when OpenAI adds Pro OAuth support for a newer model in codex release notes.
RUN npm install -g @anthropic-ai/claude-code opencode-ai @openai/codex@0.125.0

# agent user
RUN useradd -m -s /bin/bash agent && \
    groupadd -f docker && usermod -aG docker agent && \
    mkdir -p /workspace && chown agent:agent /workspace && \
    mkdir -p /home/agent/.claude /home/agent/.config/opencode && \
    chown -R agent:agent /home/agent

# SSH: key auth only
RUN mkdir -p /var/run/sshd && \
    sed -i 's/#PasswordAuthentication yes/PasswordAuthentication no/' /etc/ssh/sshd_config && \
    sed -i 's/#PubkeyAuthentication yes/PubkeyAuthentication yes/' /etc/ssh/sshd_config && \
    echo "AllowUsers agent" >> /etc/ssh/sshd_config

COPY config/agent-box/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 22
CMD ["/entrypoint.sh"]
