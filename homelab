#!/bin/bash
# Homelab Management Script
# Python-based automation system for homelab management

set -euo pipefail

# Colors
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
RED='\033[0;31m'
PURPLE='\033[0;35m'
NC='\033[0m'

# Configuration
HOMELAB_DIR="/home/luk-server/homelab"
VENV_DIR="$HOMELAB_DIR/venv"
PYTHON_SCRIPT="$HOMELAB_DIR/scripts/homelab_manager/cli.py"

# Change to homelab directory
cd "$HOMELAB_DIR"

# Activate virtual environment
activate_venv() {
    if [ -f "$VENV_DIR/bin/activate" ]; then
        source "$VENV_DIR/bin/activate"
    else
        echo -e "${RED}❌ Virtual environment not found${NC}"
        echo "Please run: python3 -m venv venv && source venv/bin/activate && pip install -r scripts/requirements.txt"
        exit 1
    fi
}

# Main function
main() {
    case "${1:-help}" in
        "deploy"|"up")
            echo -e "${BLUE}🚀 Deploying homelab...${NC}"
            activate_venv
            python "$PYTHON_SCRIPT" deploy
            ;;
        "update"|"upgrade")
            echo -e "${BLUE}🔄 Updating homelab...${NC}"
            activate_venv
            python "$PYTHON_SCRIPT" update
            ;;
        "backup")
            echo -e "${BLUE}💾 Creating backup...${NC}"
            activate_venv
            python "$PYTHON_SCRIPT" backup
            ;;
        "restore")
            if [ -z "${2:-}" ]; then
                echo -e "${RED}❌ Please specify backup path${NC}"
                echo "Usage: $0 restore <backup_path>"
                exit 1
            fi
            echo -e "${BLUE}🔄 Restoring from backup...${NC}"
            activate_venv
            python "$PYTHON_SCRIPT" restore --backup-path "$2"
            ;;
        "status"|"health")
            echo -e "${BLUE}📊 Checking homelab status...${NC}"
            activate_venv
            python "$PYTHON_SCRIPT" status
            ;;
        "check"|"health-check")
            echo -e "${BLUE}🔍 Running health check...${NC}"
            activate_venv
            python "$PYTHON_SCRIPT" health-check
            ;;
        "monitor")
            echo -e "${BLUE}📊 Starting monitoring...${NC}"
            activate_venv
            python "$PYTHON_SCRIPT" monitor
            ;;
        "logs")
            if [ -z "${2:-}" ]; then
                echo -e "${YELLOW}Available services:${NC}"
                docker ps --format "{{.Names}}"
                echo ""
                echo "Usage: $0 logs <service_name>"
                exit 1
            fi
            echo -e "${BLUE}📋 Showing logs for $2...${NC}"
            docker logs --tail=50 -f "$2"
            ;;
        "update-check")
            echo -e "${BLUE}🔄 Checking for updates...${NC}"
            activate_venv
            python "$PYTHON_SCRIPT" check-updates
            ;;
        "update-all")
            echo -e "${BLUE}🔄 Updating all services...${NC}"
            activate_venv
            python "$PYTHON_SCRIPT" update-all
            ;;
        "versions")
            echo -e "${BLUE}📋 Showing service versions...${NC}"
            activate_venv
            python "$PYTHON_SCRIPT" versions
            ;;
        "cleanup")
            echo -e "${BLUE}🧹 Cleaning up...${NC}"
            activate_venv
            python "$PYTHON_SCRIPT" cleanup
            ;;
        "setup")
            echo -e "${BLUE}⚙️ Setting up automation...${NC}"
            activate_venv
            python "$PYTHON_SCRIPT" setup-cron
            ;;
        "validate")
            echo -e "${BLUE}🔍 Validating configuration...${NC}"
            activate_venv
            python "$PYTHON_SCRIPT" validate-config
            ;;
        "config")
            echo -e "${BLUE}📋 Showing configuration summary...${NC}"
            activate_venv
            python "$PYTHON_SCRIPT" config-summary
            ;;
        "down"|"stop")
            echo -e "${BLUE}⏹️ Stopping homelab...${NC}"
            docker-compose down
            ;;
        "restart")
            echo -e "${BLUE}🔄 Restarting homelab...${NC}"
            docker-compose restart
            ;;
        "help"|*)
            echo -e "${PURPLE}🏠 Homelab Management${NC}"
            echo "==================="
            echo ""
            echo "Usage: $0 <command> [options]"
            echo ""
            echo -e "${YELLOW}🚀 Deployment:${NC}"
            echo "  deploy, up      - Deploy homelab services"
            echo "  down, stop      - Stop homelab services"
            echo "  restart         - Restart homelab services"
            echo ""
            echo -e "${YELLOW}🔄 Updates:${NC}"
            echo "  update, upgrade - Update all services"
            echo "  update-check    - Check for available updates"
            echo "  update-all      - Update all services"
            echo "  versions        - Show current versions"
            echo ""
            echo -e "${YELLOW}💾 Backup:${NC}"
            echo "  backup          - Create backup"
            echo "  restore         - Restore from backup"
            echo ""
            echo -e "${YELLOW}📊 Monitoring:${NC}"
            echo "  status, health  - Quick status check"
            echo "  check           - Full health check"
            echo "  monitor         - Continuous monitoring"
            echo "  logs            - Show service logs"
            echo ""
            echo -e "${YELLOW}🧹 Maintenance:${NC}"
            echo "  cleanup         - Clean up unused resources"
            echo "  setup           - Setup automated tasks"
            echo "  validate        - Validate configuration"
            echo "  config          - Show configuration summary"
            echo ""
            echo -e "${YELLOW}📋 Examples:${NC}"
            echo "  $0 deploy"
            echo "  $0 update"
            echo "  $0 backup"
            echo "  $0 status"
            echo "  $0 logs homeassistant"
            echo "  $0 update-check"
            echo "  $0 setup"
            echo "  $0 validate"
            echo ""
            echo -e "${GREEN}🎉 Python-based automation for your homelab!${NC}"
            ;;
    esac
}

main "$@"
