{
	"TCP": {
		"443": {
			"HTTPS": true
		}
	},
	"Web": {
		"${TS_HOSTNAME}:443": {
			"Handlers": {
				"/":                 { "Proxy": "http://127.0.0.1:3000" },
				"/jellyfin/":        { "Proxy": "http://127.0.0.1:8096" },
				"/grafana/":         { "Proxy": "http://127.0.0.1:3002" },
				"/portainer/":       { "Proxy": "https://127.0.0.1:9443" },
				"/uptime/":          { "Proxy": "http://127.0.0.1:3001" },
				"/nextcloud/":       { "Proxy": "http://127.0.0.1:8080" },
				"/paperless/":       { "Proxy": "http://127.0.0.1:8010" },
				"/n8n/":             { "Proxy": "http://127.0.0.1:5678" },
				"/homeassistant/":   { "Proxy": "http://127.0.0.1:8123" }
			}
		}
	},
	"AllowFunnel": {}
}
