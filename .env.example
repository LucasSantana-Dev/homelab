# Network Configuration
# Host interface that service ports publish to. Defaults to 127.0.0.1 (loopback
# only) in every compose file, so admin UIs (Portainer, Grafana, Homepage, etc.)
# are NOT exposed on the LAN out of the box — they are reached via the caddy-lan
# reverse proxy or Tailscale. Only widen this (e.g. to your Tailscale IP) if you
# know you need direct off-host access to the raw ports.
BIND_IP=127.0.0.1
TAILSCALE_IP=YOUR_TAILSCALE_IP_HERE
DOMAIN=your-domain.com
CLOUDFLARED_TUNNEL_TOKEN=
CLOUDFLARE_API_TOKEN=
CERTBOT_EMAIL=you@example.com

# Image Locks (critical services — digest-pinned via scripts/maintenance/image-locks.sh).
# Tags below mirror the compose defaults; run `make image-lock-refresh` to fill <digest>.
IMG_CLOUDFLARED=cloudflare/cloudflared:2025.4.0
IMG_HOMEASSISTANT=ghcr.io/home-assistant/home-assistant:2025.5@sha256:<digest>
IMG_PIHOLE=pihole/pihole:2026.06.0@sha256:<digest>
IMG_NEXTCLOUD=nextcloud:29-apache@sha256:<digest>
IMG_MARIADB=mariadb:11.4.10@sha256:<digest>
IMG_N8N=n8nio/n8n:2.27.1
IMG_GRAFANA=grafana/grafana-oss:11.4.6@sha256:<digest>
IMG_PORTAINER=portainer/portainer-ce:2.42.0@sha256:<digest>
IMG_PROMETHEUS=prom/prometheus:v2.54.1@sha256:<digest>
IMG_ALERTMANAGER=prom/alertmanager:v0.28.1@sha256:<digest>
IMG_CADVISOR=gcr.io/cadvisor/cadvisor:v0.49.1@sha256:<digest>
IMG_PAPERLESS_BASE=ghcr.io/paperless-ngx/paperless-ngx:2.13@sha256:<digest>
IMG_POSTGRES_15_ALPINE=postgres:15.17-alpine@sha256:<digest>
IMG_REDIS_ALPINE=redis:7.4-alpine@sha256:<digest>
# Added 2026-04: overrides for the remaining services (defaults live in compose/*.yml).
# Set a concrete tag + digest for reproducible pulls; otherwise the compose defaults apply.
IMG_STREMIO=stremio/server:v4.21.0
IMG_HOMEPAGE=ghcr.io/gethomepage/homepage:v1.13.2
IMG_WUD=fmartinou/whats-up-docker:6.6.1
IMG_NODE_EXPORTER=prom/node-exporter:v1.9.1
IMG_BLACKBOX=prom/blackbox-exporter:v0.28.0
IMG_GATUS=twinproduction/gatus:v5.36.0
IMG_LOKI=grafana/loki:3.7.2
IMG_PROMTAIL=grafana/promtail:3.6.11
IMG_CADDY=caddy:2.10.2-alpine
# STREMIO_PUBLIC_URL: HTTPS endpoint the Stremio Web app targets. Default is the
# Tailscale Funnel URL emitted by `sudo tailscale funnel --bg 11470`.
STREMIO_PUBLIC_URL=https://your-funnel-host.ts.net

# User Configuration
PUID=1000
PGID=1000
TIMEZONE=America/Sao_Paulo

# Service Ports
HOMEPAGE_PORT=3000
HOMEASSISTANT_PORT=8123
PORTAINER_PORT=9000
GRAFANA_PORT=3002
PROMETHEUS_PORT=9091
WUD_PORT=3003
PIHOLE_WEB_PORT=8054
PIHOLE_DNS_PORT=53
FILEBROWSER_PORT=8080
NODE_EXPORTER_PORT=9100
FORGE_MCP_GATEWAY_PORT=4444

# Service Passwords & Keys
HOMEASSISTANT_KEY=YOUR_HOMEASSISTANT_KEY_HERE
GRAFANA_PASSWORD=YOUR_GRAFANA_PASSWORD_HERE
PIHOLE_WEB_PASSWORD=YOUR_PIHOLE_PASSWORD_HERE

# Update/Notification Webhooks
# Recommended: 2 logical channels mapped to 4 vars.
# - maintenance: UPDATE_DISCORD_WEBHOOK_URL and WUD_DISCORD_WEBHOOK_URL share the same value.
UPDATE_DISCORD_WEBHOOK_URL=
WUD_DISCORD_WEBHOOK_URL=
# Discord webhook the n8n ops-digest workflow posts to (ADR-0025 Phase 2; the
# cross-source Sentry/healthchecks/WUD feed). Empty = workflow inactive.
# See docs/runbooks/ops-alert-digest.md.
OPS_DIGEST_DISCORD_WEBHOOK=

# What's Up Docker Configuration (Optional - leave empty if not using)
WUD_SMTP_HOST=
WUD_SMTP_PORT=587
WUD_SMTP_USER=admin
WUD_SMTP_PASS=

# Docker Hub & GitHub Tokens (Optional - for container updates)
DOCKER_HUB_TOKEN=
GITHUB_TOKEN=

# Homepage GitHub token — raises rate limit from 15 req/hr (unauthed) to 5000 req/hr.
# Optional: widgets degrade gracefully without it.
HOMEPAGE_GITHUB_TOKEN=

# Nextcloud Cloud Storage
NEXTCLOUD_DB_ROOT_PASSWORD=YOUR_NEXTCLOUD_DB_ROOT_PASSWORD_HERE
NEXTCLOUD_DB_PASSWORD=YOUR_NEXTCLOUD_DB_PASSWORD_HERE

# Alertmanager Configuration
# - incidents: ALERTMANAGER_DISCORD_WEBHOOK and WATCHDOG_DISCORD_WEBHOOK share the same value.
ALERTMANAGER_DISCORD_WEBHOOK=YOUR_DISCORD_WEBHOOK_HERE

# Homelab Watchdog Configuration
# Set to "true" only after validating recovery actions in your environment
WATCHDOG_REBOOT_ENABLED=false
WATCHDOG_RECOVERY_WINDOW_MINUTES=10
# Set dedicated watchdog webhook (no fallback to ALERTMANAGER_DISCORD_WEBHOOK).
WATCHDOG_DISCORD_WEBHOOK=

# Sentry Configuration
SENTRY_AUTH_TOKEN=YOUR_SENTRY_AUTH_TOKEN_HERE

# What's Up Docker Authentication
# Generate htpasswd file: cd /home/luk-server/homelab && sudo htpasswd -c config/nginx/auth/wud.htpasswd admin
WUD_AUTH_USER=admin
WUD_AUTH_PASSWORD=YOUR_SECURE_PASSWORD_HERE

# Grafana SSO Controls
GRAFANA_OAUTH_ENABLED=true
GRAFANA_DISABLE_LOGIN_FORM=true

# Paperless-ngx Document Management
PAPERLESS_SECRET_KEY=YOUR_PAPERLESS_SECRET_KEY_HERE
PAPERLESS_DB_PASSWORD=YOUR_PAPERLESS_DB_PASSWORD_HERE
PAPERLESS_ADMIN_PASSWORD=YOUR_PAPERLESS_ADMIN_PASSWORD_HERE

# Forge Space / IBM Context Forge (optional profile: forge-space)
FORGE_MCP_JWT_SECRET_KEY=GENERATE_MIN_32_CHAR_SECRET
FORGE_MCP_BASIC_AUTH_USER=admin
FORGE_MCP_BASIC_AUTH_PASSWORD=YOUR_FORGE_MCP_BASIC_AUTH_PASSWORD_HERE
FORGE_MCP_ADMIN_EMAIL=admin@example.com
FORGE_MCP_ADMIN_PASSWORD=YOUR_FORGE_MCP_ADMIN_PASSWORD_HERE
FORGE_MCP_ADMIN_FULL_NAME=Forge Platform Admin
FORGE_MCP_AUTH_REQUIRED=true
FORGE_MCP_UI_ENABLED=true
FORGE_MCP_ADMIN_API_ENABLED=true
FORGE_MCP_SECURE_COOKIES=false

# Forge MCP client registration (used by scripts/deployment/setup-forge-space-mcp.sh)
# Set FORGE_MCP_SERVER_URL after creating a virtual server in the Forge admin UI.
FORGE_MCP_SERVER_URL=http://127.0.0.1:4444/servers/<UUID>/mcp
FORGE_MCP_JWT=

# Lucky bot internal notify endpoint (replaces deprecated WATCHDOG_DISCORD_WEBHOOK)
LUCKY_NOTIFY_URL=http://localhost:8090/api/internal/notify
LUCKY_NOTIFY_KEY=
LUCKY_NOTIFY_CHANNEL_ID=

# Lucky Postgres recovery credentials — consumed by scripts/maintenance/recover-lucky-db.sh.
# Required when running the recovery script; do not commit real values.
LUCKY_DB_NAME=discordbot
LUCKY_DB_USER=discordbot
LUCKY_DB_PASSWORD=
LUCKY_DB_CONTAINER=lucky-postgres

# Forgejo (self-hosted git) port bindings
# SSH port 2222 may conflict if the host already binds it; override with a free port (e.g. 2223)
FORGEJO_HTTP_PORT=9096
FORGEJO_SSH_PORT=2223

# ---------------------------------------------------------------------------
# Tinyauth — OAuth authentication middleware (compose/auth.yml)
# Protects all public services behind Google or GitHub OAuth login.
# ---------------------------------------------------------------------------
# Docker image pin (uses tinyauth v5 preset support for google + github)
IMG_TINYAUTH=ghcr.io/steveiliop56/tinyauth:v5.0.7

# Comma-separated list of email addresses allowed to log in.
# Use your primary email on both Google and GitHub.
# Example: TINYAUTH_ALLOWED_EMAILS=you@gmail.com
TINYAUTH_ALLOWED_EMAILS=

# Google OAuth — create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://auth.<your-domain>/api/oauth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth — create at https://github.com/settings/developers (OAuth Apps)
# Authorization callback URL: https://auth.<your-domain>/api/oauth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ===========================================================================
# CrowdSec — IPS, blocklist sharing, plugs into Caddy via bouncer
# ---------------------------------------------------------------------------
IMG_CROWDSEC=crowdsecurity/crowdsec:v1.7.8
# API port (LAN-bound by default). Bouncers connect here.
# Note: was 8090 prior to 2026-05-16. Bumped to 8091 because lucky-nginx
# (Lucky Discord bot, separate compose project on the same host) binds
# 0.0.0.0:8090. Docker rejects the second bind and crowdsec ends up
# orphaned from its docker network — see homelab v2.4.4 post-deploy notes.
CROWDSEC_API_PORT=8091

# ===========================================================================
# Healthchecks — self-hosted dead-man-switch for cron / backup jobs
# ---------------------------------------------------------------------------
IMG_HEALTHCHECKS=healthchecks/healthchecks:v4.2
HEALTHCHECKS_PORT=8092
# 50+ char random string. Generate: openssl rand -hex 32
HEALTHCHECKS_SECRET_KEY=
HEALTHCHECKS_SUPERUSER_EMAIL=
HEALTHCHECKS_SUPERUSER_PASSWORD=
# Postgres password for the healthchecks DB. Required (compose uses :?must be set);
# must match the value the healthchecks_db volume was initialised with.
HEALTHCHECKS_DB_PASSWORD=
# SMTP for healthchecks magic-link login + down-check notification emails (#264).
# Leave HEALTHCHECKS_EMAIL_HOST empty to keep email disabled (password login still
# works). To enable, e.g. Gmail with an App Password (https://myaccount.google.com/apppasswords):
#   HEALTHCHECKS_EMAIL_HOST=smtp.gmail.com
#   HEALTHCHECKS_EMAIL_HOST_USER=you@gmail.com
#   HEALTHCHECKS_EMAIL_HOST_PASSWORD=<16-char app password>
# Or a transactional provider (Brevo/Resend/Mailgun): set host/user/password accordingly.
HEALTHCHECKS_EMAIL_HOST=
HEALTHCHECKS_EMAIL_PORT=587
HEALTHCHECKS_EMAIL_HOST_USER=
HEALTHCHECKS_EMAIL_HOST_PASSWORD=
HEALTHCHECKS_EMAIL_USE_TLS=True

# ===========================================================================
# Kopia — encrypted, deduplicated backups → S3-compatible offsite (B2 default)
# ---------------------------------------------------------------------------
IMG_KOPIA=kopia/kopia:0.21.1
KOPIA_PORT=51515
# Generate: openssl rand -hex 32  (LOSE THIS = LOSE THE BACKUPS, store in your password manager)
KOPIA_REPO_PASSWORD=
KOPIA_SERVER_USERNAME=admin
KOPIA_SERVER_PASSWORD=
# Backblaze B2 by default; works for any S3-compatible object store (R2, Wasabi).
KOPIA_S3_ENDPOINT=s3.us-west-002.backblazeb2.com
KOPIA_S3_BUCKET=
KOPIA_S3_ACCESS_KEY=
KOPIA_S3_SECRET_KEY=
# Base64-encoded "user:password" for the healthcheck. Default = "admin:admin".
# Update after rotating KOPIA_SERVER_PASSWORD.
KOPIA_HEALTH_BASIC_AUTH=YWRtaW46YWRtaW4=
# Offsite mirror target for the encrypted kopia repo (#266), consumed by
# scripts/maintenance/kopia-offsite-sync.sh + its systemd timer. Empty = disabled.
# A remote host (rsync over ssh; root must have a key to it) or a mounted disk:
#   KOPIA_OFFSITE_TARGET=luk@pc-do-luk:/srv/kopia-offsite
#   KOPIA_OFFSITE_TARGET=/mnt/usb-backup/kopia-offsite
KOPIA_OFFSITE_TARGET=
# Alternative offsite backend: an rclone remote (cloud — Google Drive, S3, B2…).
# Takes precedence over KOPIA_OFFSITE_TARGET if both are set. Configure the remote
# once with `rclone config` (see docs/backup.md), then set "remote:path":
#   KOPIA_OFFSITE_RCLONE_REMOTE=gdrive:homelab-kopia
KOPIA_OFFSITE_RCLONE_REMOTE=
# Optional healthchecks.io-style ping URL for the offsite sync (success / +/fail).
KOPIA_OFFSITE_HC_PING_URL=

# --- GitHub Stats Extended (compose/stats.yml) ---
# PAT the self-hosted card renderer authenticates with. Needs to read your
# private repos, otherwise the cards show public-only language shares. Try a
# fine-grained token (All repositories, read-only Contents + Metadata) first;
# a classic token needs repo + read:user but grants write across every repo.
GITHUB_STATS_PAT=
# Shared secret gating the public stats.lucassantana.tech host at Caddy. Must match the
# STATS_KEY secret in the LucasSantana-Dev/LucasSantana-Dev repo. Generate with:
#   openssl rand -hex 32
GITHUB_STATS_KEY=

# Shared token for the knowledge-brain MCP server (brain.lucassantana.tech).
# The only thing standing between the public hostname and the whole knowledge
# brain - the server refuses to boot with fewer than 32 chars. Generate with:
#   openssl rand -hex 32
# It is also pasted into claude.ai > Settings > Connectors, either as an
# Authorization request header ("Bearer <token>") or inside the connector URL
# (https://brain.lucassantana.tech/<token>/mcp). Rotating it means updating both.
BRAIN_MCP_TOKEN=
# Comma-separated Host allowlist for MCP DNS-rebinding protection; "*" disables it.
BRAIN_MCP_ALLOWED_HOSTS=*
# Build context for the brain-mcp image, synced by rag-index/remote/sync-to-homelab.sh
BRAIN_MCP_SRC=/home/luk-server/homelab/appdata/brain-mcp/src

# brainchat-web: the browser chat over the brain (brain.lucassantana.tech, behind
# tinyauth). Anthropic by default because the box has no RAM headroom for a local
# model good enough to keep citations honest. Flip BRAINCHAT_PROVIDER to ollama to
# go local; BRAINCHAT_MODEL then defaults per provider, so leave it empty unless
# you want a specific one.
ANTHROPIC_API_KEY=
BRAINCHAT_PROVIDER=anthropic
BRAINCHAT_MODEL=
# Spend ceiling for the paid provider: input size is already capped, so limiting
# asks per hour limits the bill.
BRAINCHAT_MAX_ASKS_PER_HOUR=60
