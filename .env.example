# Ultra-Optimized Homelab Environment Variables
# WARNING: This file contains sensitive information - never commit to git

# Network Configuration
TAILSCALE_IP=your_tailscale_ip_here
TIMEZONE=your_timezone_here

# User Configuration
PUID=your_puid_here
PGID=your_pgid_here

# Domain Configuration
DOMAIN=your_domain_here

# Cloudflare Configuration
CF_API_TOKEN=your_cf_api_token_here
CF_TUNNEL_ID=your_cf_tunnel_id_here

# Pi-hole Configuration
PIHOLE_WEB_PASSWORD=your_pihole_web_password_here
PIHOLE_LOCAL_IPV4=your_pihole_local_ipv4_here

# File Paths
MEDIA_PATH=/home/luk-server/media
USER_HOME=/home/luk-server

# Service Ports (ultra-minimal stack)
HOMEPAGE_PORT=3000
STREMIO_PORT=8080
HOMEASSISTANT_PORT=8123
PORTAINER_PORT=9000
PIHOLE_DNS_PORT=5354
PIHOLE_WEB_PORT=8054

# Monitoring Stack Ports
GRAFANA_PORT=3002
PROMETHEUS_PORT=9091
NODE_EXPORTER_PORT=9100
UPTIME_KUMA_PORT=3001

# Grafana Configuration
GRAFANA_PASSWORD=your_grafana_password_here

# Sentry Configuration (Lukbot Service)
LUKBOT_SENTRY_DSN=your_lukbot_sentry_dsn_here
LUKBOT_SENTRY_ORG_SLUG=your_lukbot_sentry_org_slug_here
LUKBOT_SENTRY_PROJECT_SLUG=your_lukbot_sentry_project_slug_here
LUKBOT_SENTRY_AUTH_TOKEN=your_lukbot_sentry_auth_token_here

# Homeassistant Configuration
HOMEASSISTANT_KEY=your_homeassistant_key_here

# What's up Docker? Configuration
WUD_PORT=3003
WUD_DISCORD_WEBHOOK_URL=your_wud_discord_webhook_url_here
WUD_SMTP_HOST=
WUD_SMTP_PORT=587
WUD_SMTP_USER=Luk
WUD_SMTP_PASS=your_wud_smtp_pass_here
WUD_SMTP_FROM=
WUD_SMTP_TO=