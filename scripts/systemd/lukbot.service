[Unit]
Description=LukBot Discord Bot
Requires=docker.service
After=docker.service network-online.target homelab-docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/luk-server/LukBot
ExecStartPre=/usr/bin/sleep 5
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
User=luk-server
Group=luk-server
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
