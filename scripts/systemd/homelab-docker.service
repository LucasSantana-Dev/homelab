[Unit]
Description=Homelab Docker Compose Services
Requires=docker.service tailscaled.service
After=docker.service tailscaled.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/luk-server/homelab
# Wait for BIND_IP (the Tailscale address) instead of a fixed sleep: publishing
# on it fails until tailscale0 has the address. Never fails the unit.
ExecStartPre=/home/luk-server/homelab/scripts/maintenance/wait-for-bind-ip.sh
# No `compose pull` and no `build` here. Boot only starts what is already
# deployed: a pull would move mutable tags (:latest) past the image-drift gate
# of `make deploy`, and `up -d` still pulls any image that is missing. The
# paperless-ngx build (optional profile, never started by `up -d`) spent 29 min
# downloading its base image on the 2026-09-29 boot until TimeoutStartSec
# killed the unit, so `up` never ran from here.
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
User=luk-server
Group=luk-server
TimeoutStartSec=1800

[Install]
WantedBy=multi-user.target
