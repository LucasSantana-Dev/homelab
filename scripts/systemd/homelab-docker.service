[Unit]
Description=Homelab Docker Compose Services
Requires=docker.service tailscaled.service
After=docker.service tailscaled.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/luk-server/homelab
# Wait for BIND_IP (the Tailscale address) instead of a fixed sleep: publishing
# on it fails until tailscale0 has the address. Never fails the unit.
ExecStartPre=/home/luk-server/homelab/scripts/maintenance/wait-for-bind-ip.sh
# Best effort ("-"): a failed pull must not skip `up`. On 2026-09-20 the pull of the
# locally built agent-box/homelab-manager failed, so the containers that had lost
# their Tailscale-IP port binds at boot were never started again.
ExecStartPre=-/usr/bin/docker compose pull --quiet --ignore-buildable
# `-`: a failed build (no internet at boot) must not stop `compose up`.
ExecStartPre=-/usr/bin/docker compose build paperless-ngx
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
User=luk-server
Group=luk-server
TimeoutStartSec=1800

[Install]
WantedBy=multi-user.target
