[Unit]
Description=labwc headless Wayland session (Roblox AFK rig)
After=graphical-session-pre.target

[Service]
Type=simple
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=WLR_BACKENDS=headless
Environment=WLR_RENDERER=gles2
Environment=WLR_LIBINPUT_NO_DEVICES=1
ExecStart=/usr/bin/labwc
# Publish the created WAYLAND_DISPLAY so downstream user units inherit it.
ExecStartPost=/bin/sh -c 'for i in $(seq 1 40); do [ -S "$XDG_RUNTIME_DIR/wayland-0" ] && { systemctl --user set-environment WAYLAND_DISPLAY=wayland-0; break; }; sleep 0.5; done'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
