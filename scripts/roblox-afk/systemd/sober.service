[Unit]
Description=Sober / Roblox client (AFK rig)
After=labwc.service wayvnc.service
BindsTo=labwc.service

[Service]
Type=simple
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=WAYLAND_DISPLAY=wayland-0
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
ExecStartPre=/bin/sh -c 'until [ -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ]; do sleep 0.5; done'
ExecStart=/usr/bin/flatpak run org.vinegarhq.Sober
# Roblox login is cached after first interactive sign-in; on boot Sober resumes it.
# If the token has expired it will render the login screen (harmless — not in a game).
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
